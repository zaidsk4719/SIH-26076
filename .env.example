# ==============================================================================
# Mausam (SIH 26076) - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Runtime Configuration
# ------------------------------------------------------------------------------
# Port for the Express backend gateway (defaults to 3000)
PORT=3000

# Environment mode: development | production
NODE_ENV=development

# Optional public application URL (used in /api/app-info status endpoint)
APP_URL=http://localhost:3000

# Set to 'true' in headless/preview iframe environments to disable HMR websocket logs
DISABLE_HMR=false

# ------------------------------------------------------------------------------
# Google Gemini AI (Server-Side Only)
# ------------------------------------------------------------------------------
# Required for live Mausam AI personalized meteorological insights and conversational Q&A.
# If omitted or exhausted, the system automatically falls back to the deterministic rule engine.
# Obtain key at: https://aistudio.google.com/
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Redis Cache (Optional - Hot-swappable in-memory fallback enabled by default)
# ------------------------------------------------------------------------------
# Redis connection string (takes precedence over REDIS_HOST if provided)
REDIS_URL=
# REDIS_TLS_URL=

# Standalone Redis host & port parameters
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Supabase PostgreSQL (Optional - In-memory map fallback enabled by default)
# ------------------------------------------------------------------------------
# Supabase project URL and API keys for user preference persistence
SUPABASE_URL=
# SUPABASE_PROJECT_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_KEY=

# ------------------------------------------------------------------------------
# API Setu (MeitY / National Open API Platform Gateway - Optional)
# ------------------------------------------------------------------------------
# Base URL for API Setu endpoints (defaults to https://apisetu.gov.in/api/v1)
APISETU_BASE_URL=https://apisetu.gov.in/api/v1
APISETU_CLIENT_ID=
APISETU_API_KEY=
